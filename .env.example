# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and will never be committed.
# All variables must also be added to Netlify → Site settings → Environment variables.

# Google Analytics 4
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Supabase
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
VITE_SUPABASE_ADMIN_TOKEN=your-admin-password

# Cloudinary (unsigned preset — safe to expose in the client bundle)
VITE_CLOUDINARY_CLOUD_NAME=djkgbl2kx
VITE_CLOUDINARY_PRESET=your-unsigned-preset-name
